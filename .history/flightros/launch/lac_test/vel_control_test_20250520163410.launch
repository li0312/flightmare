<launch>
    <arg name="debug" default="0" />
    <arg name="use_unity_editor" default="false" />

    <!-- RPG Flightmare Unity Render. -->
    <node pkg="flightrender" type="RPG_Flightmare.x86_64" name="rpg_flightmare_render" unless="$(arg use_unity_editor)">
    </node>

    <node name="vel_control_test" pkg="flightros" type="vel_control_test" output="screen" launch-prefix="gdb -ex run --args" if="$(arg debug)" >
    </node>

    <node name="vel_control_test" pkg="flightros" type="vel_control_test" output="screen" unless="$(arg debug)">
    </node>
        
    <node name="rviz" pkg="rviz" type="rviz"  args="-d $(find flightros)/launch/lac_test/vel_test.rviz"/>

</launch>